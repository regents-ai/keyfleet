new file mode 100644
index 00000000..20bd1954
--- /dev/null
+++ b/packages/core/src/services/jobs/runFailure.ts
@@ -0,0 +1,125 @@
+import type { RunError, RunFailure } from '../../schema';
+import { utf8Tail } from '../../text';
+import type { SessionEnv } from '../runtime/sandboxEnvironment';
+
+export const FAILURE_EXCERPT_LINES = 20;
+export const FAILURE_EXCERPT_BYTES = 2000;
+
+const REMOVED = '[removed]';
+/** Shorter injected values are too likely to be ordinary words to remove everywhere. */
+const MIN_INJECTED_LENGTH = 6;
+
+/** A pair's value: quoted as a whole, or up to the next separator. */
+const PAIR_VALUE = String.raw`(?:"[^"\n]*"|'[^'\n]*'|[^\s"',;&]+)`;
+
+/** Credential shapes, masked in this order after the injected values are gone. */
+const CREDENTIAL_PATTERNS: readonly [RegExp, string][] = [
+	[/-----BEGIN [A-Z0-9 ]{1,64}-----[\s\S]*?(?:-----END [A-Z0-9 ]{1,64}-----|$)/g, REMOVED],
+	[/\b([a-z][a-z0-9+.-]{0,31}:\/\/)[^\s/?#@:]*(?::[^\s@]*)?@/gi, `$1${REMOVED}@`],
+	[
+		/\b(authorization["']?\s*[:=]\s*["']?(?:(?:bearer|basic|token|digest|negotiate)\s+)?)[^\s"',;]+/gi,
+		`$1${REMOVED}`,
+	],
+	[/\b(bearer\s+)[^\s"',;]+/gi, `$1${REMOVED}`],
+	[/eyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]*/g, REMOVED],
+	[/\b(FlyV1\s+)[^\s"']+/g, `$1${REMOVED}`],
+	[
+		/(?<![A-Za-z0-9])(?:sk-[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9]{16,}|github_pat_[A-Za-z0-9_]{16,}|xox[a-z]-[A-Za-z0-9-]{8,}|(?:AKIA|ASIA)[0-9A-Z]{16}|fm2_[A-Za-z0-9+/=_-]{8,})/g,
+		REMOVED,
+	],
+	[
+		new RegExp(
+			String.raw`\b([A-Za-z0-9_.-]{0,64}(?:key|token|secret|password|passwd|pwd)["']?\s*[:=]\s*)${PAIR_VALUE}`,
+			'gi',
+		),
+		`$1${REMOVED}`,
+	],
+	[/[0-9a-fA-F]{32,}/g, REMOVED],
+];
+
+const BASE64_RUN = /[A-Za-z0-9+/_-]{32,}={0,2}/g;
+
+/** Mixed case, or letters with digits outside a path: lowercase paths and names survive. */
+function maskBase64Run(run: string): string {
+	const mixedCase = /[A-Z]/.test(run) && /[a-z]/.test(run);
+	const alphanumeric = /[0-9]/.test(run) && /[A-Za-z]/.test(run) && !run.includes('/');
+	return mixedCase || alphanumeric ? REMOVED : run;
+}
+
+function base64(bytes: Uint8Array): string {
+	let binary = '';
+	for (const byte of bytes) binary += String.fromCharCode(byte);
+	return btoa(binary).replace(/=+$/, '');
+}
+
+/**
+ * The base64 text of `value` at each of the three alignments it can take inside
+ * a larger encoded string, cut to the characters that depend on `value` alone.
+ */
+function base64Forms(value: string): string[] {
+	const bytes = new TextEncoder().encode(value);
+	return [0, 1, 2].flatMap((offset) => {
+		const aligned = new Uint8Array(offset + bytes.length);
+		aligned.set(bytes, offset);
+		const encoded = base64(aligned).slice(
+			Math.ceil((offset * 4) / 3),
+			Math.floor((aligned.length * 4) / 3),
+		);
+		return [encoded, encoded.replaceAll('+', '-').replaceAll('/', '_')];
+	});
+}
+
+function injectedForms(value: string): string[] {
+	const uri = encodeURIComponent(value);
+	return [
+		value,
+		uri,
+		uri.replaceAll(/%[0-9A-F]{2}/g, (escape) => escape.toLowerCase()),
+		new URLSearchParams({ v: value }).toString().slice(2),
+		...base64Forms(value),
+	];
+}
+
+/** Every value the hub put into the run's environment. */
+export function injectedValues(env: SessionEnv | undefined): string[] {
+	return [...Object.values(env?.vars ?? {}), ...Object.values(env?.defaults ?? {})];
+}
+
+/**
+ * Remove secrets from a stage's output: first every injected value (plain,
+ * URL-encoded and base64-encoded), then anything shaped like a credential.
+ */
+export function redactOutput(output: string, injected: readonly string[]): string {
+	const forms = [
+		...new Set(
+			injected.filter((value) => value.length >= MIN_INJECTED_LENGTH).flatMap(injectedForms),
+		),
+	].sort((a, b) => b.length - a.length);
+	let text = output;
+	for (const form of forms) text = text.replaceAll(form, REMOVED);
+	for (const [pattern, replacement] of CREDENTIAL_PATTERNS) {
+		text = text.replaceAll(pattern, replacement);
+	}
+	return text.replaceAll(BASE64_RUN, maskBase64Run);
+}
+
+/** The redacted last lines of a stage's output, capped; undefined when it printed nothing. */
+export function failureExcerpt(output: string, injected: readonly string[]): string | undefined {
+	const lines = redactOutput(output, injected).trimEnd().split(/\r?\n/);
+	const excerpt = utf8Tail(lines.slice(-FAILURE_EXCERPT_LINES).join('\n'), FAILURE_EXCERPT_BYTES);
+	return excerpt.trim() ? excerpt : undefined;
+}
+
+export function runFailure(
+	stage: RunFailure['stage'],
+	error: RunError,
+	exitStatus?: number,
+	excerpt?: string,
+): RunFailure {
+	return {
+		stage,
+		...(exitStatus !== undefined ? { exit_status: exitStatus } : {}),
+		message: error.message,
+		...(excerpt !== undefined ? { excerpt } : {}),
+	};
+}
