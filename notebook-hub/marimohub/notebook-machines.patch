+const NotebookMachineSchema = z
+	.object({
+		id: z.string().openapi({
+			description: 'The session id of a session machine, the run id of a job run machine',
+		}),
+		kind: z.enum(['session', 'run']),
+		started_at: utcTimestamp(),
+		ended_at: utcTimestamp().nullable().openapi({
+			description:
+				"When the machine ended: a session's sandbox confirmed destroyed, a run finished. Null while it may still run.",
+		}),
+	})
+	.openapi('AdminNotebookMachine');
+
+const listMachines = createRoute({
+	method: 'get',
+	path: '/admin/machines',
+	operationId: 'admin.machines.list',
+	tags: ['Admin'],
+	summary: 'List the notebook machines the hub holds records of',
+	description:
+		'Every session given a sandbox and every job run that provisioned one, while the hub keeps ' +
+		'its record: an ended session until it is reaped, a run for the run retention. Currently a ' +
+		'single page (`next_cursor` is always null). Super-admin only and session-only.',
+	security: SESSION_ONLY_SECURITY,
+	responses: {
+		200: jsonContent(
+			z.object({
+				success: z.literal(true),
+				data: pageSchema(NotebookMachineSchema, 'AdminNotebookMachinePage'),
+			}),
+			'The notebook machines, sessions then runs',
