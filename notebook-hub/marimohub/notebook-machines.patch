diff --git a/packages/api/src/routes/admin.machines.test.ts b/packages/api/src/routes/admin.machines.test.ts
new file mode 100644
index 00000000..b41575da
--- /dev/null
+++ b/packages/api/src/routes/admin.machines.test.ts
@@ -0,0 +1,142 @@
+import { beforeEach, describe, expect, it } from 'vitest';
+import { createServices, createSessionId, paths, SandboxId } from '@marimo-hub/core';
+import type { NotebookId, ProjectId, Session } from '@marimo-hub/core';
+import type { MemoryBucket } from '@marimo-hub/core/testing';
+import { ACTOR, makeSession } from '@marimo-hub/core/testing';
+import { createApi } from '../createApi';
+import {
+	createInitializedBucket,
+	createTestApi,
+	expectError,
+	expectOk,
+	makeTestDeps,
+} from '../testing';
+
+describe('GET /admin/machines', () => {
+	let bucket: MemoryBucket;
+	let services: ReturnType<typeof createServices>;
+	let pid: ProjectId;
+	let nid: NotebookId;
+
+	beforeEach(async () => {
+		bucket = await createInitializedBucket();
+		services = createServices(bucket);
+		pid = (await services.projects.createProject({ name: 'p', description: '' }, ACTOR)).id;
+		nid = (
+			await services.notebooks.createNotebook(
+				pid,
+				{ title: 'nb', description: '', code: 'import marimo' },
+				ACTOR,
+			)
+		).id;
+	});
+
+	const superAdmin = () =>
+		createTestApi({ bucket, userId: ACTOR, deps: { policy: { superAdmins: [ACTOR] } } }).request;
+
+	async function session(overrides: Partial<Session>): Promise<Session> {
+		const record = makeSession({ project_id: pid, notebook_id: nid, ...overrides });
+		await bucket.put(paths.session(pid, record.session_id), JSON.stringify(record));
+		return record;
+	}
+
+	async function run(request: ReturnType<typeof superAdmin>, jobId: string) {
+		const queued = await expectOk<any>(
+			await request('POST', `/projects/${pid}/notebooks/${nid}/jobs/${jobId}/runs`),
+			201,
+		);
+		return services.jobRuns.getRun(pid, nid, jobId as never, queued.run_id);
+	}
+
+	it('refuses anyone signed out, and anyone who is not a super admin', async () => {
+		await expectError(
+			await createApi(makeTestDeps(bucket)).request('/api/v1/admin/machines'),
+			401,
+			'UNAUTHORIZED',
+		);
+		const { request } = createTestApi({ bucket, userId: ACTOR });
+		await expectError(await request('GET', '/admin/machines'), 403, 'FORBIDDEN');
+	});
+
+	it('lists each session and run that had a machine, ended once its machine is gone', async () => {
+		const running = await session({
+			sandbox_id: SandboxId.parse('sb-0000000000000001'),
+			started_at: '2026-11-12T10:00:00.000Z',
+		});
+		const reclaimed = await session({
+			sandbox_id: SandboxId.parse('sb-0000000000000002'),
+			status: 'terminated',
+			started_at: '2026-11-12T08:00:00.000Z',
+			sandbox_reclaimed_at: '2026-11-12T09:30:00.000Z',
+		});
+		const awaitingTeardown = await session({
+			sandbox_id: SandboxId.parse('sb-0000000000000003'),
+			status: 'expired',
+			started_at: '2026-11-12T06:00:00.000Z',
+		});
+		// A starting session whose first sandbox was reclaimed before a replacement.
+		const replacing = await session({
+			sandbox_id: SandboxId.parse('sb-0000000000000004'),
+			status: 'starting',
+			started_at: '2026-11-12T11:00:00.000Z',
+			sandbox_reclaimed_at: '2026-11-12T11:00:05.000Z',
+		});
+		await session({ session_id: createSessionId(), status: 'failed' });
+
+		const request = superAdmin();
+		const job = await expectOk<any>(
+			await request('POST', `/projects/${pid}/notebooks/${nid}/jobs`, { name: 'nightly' }),
+			201,
+		);
+		const finished = await run(request, job.id);
+		await services.jobRuns.transition(finished, 'provision', () => ({
+			sandbox_id: SandboxId.parse('sb-0000000000000005'),
+			started_at: '2026-11-12T07:00:00.000Z',
+		}));
+		await services.jobRuns.transition(finished, 'start');
+		const done = await services.jobRuns.transition(finished, 'succeed', () => ({
+			finished_at: '2026-11-12T07:20:00.000Z',
+		}));
+		expect(done.run.status).toBe('succeeded');
+		const active = await run(request, job.id);
+		await services.jobRuns.transition(active, 'provision', () => ({
+			sandbox_id: SandboxId.parse('sb-0000000000000006'),
+			started_at: '2026-11-12T11:30:00.000Z',
+		}));
+		await run(request, job.id);
+
+		const res = await request('GET', '/admin/machines');
+		expect(res.headers.get('cache-control')).toBe('no-store');
+		const data = await expectOk<any>(res);
+		expect(data.next_cursor).toBeNull();
+		const byId = (id: string) => data.items.find((item: { id: string }) => item.id === id);
+		expect(data.items).toHaveLength(6);
+		expect(byId(running.session_id)).toEqual({
+			id: running.session_id,
+			kind: 'session',
+			started_at: '2026-11-12T10:00:00.000Z',
+			ended_at: null,
+		});
+		expect(byId(reclaimed.session_id)).toMatchObject({ ended_at: '2026-11-12T09:30:00.000Z' });
+		expect(byId(awaitingTeardown.session_id)).toMatchObject({ ended_at: null });
+		expect(byId(replacing.session_id)).toMatchObject({ ended_at: null });
+		expect(byId(finished.run_id)).toEqual({
+			id: finished.run_id,
+			kind: 'run',
+			started_at: '2026-11-12T07:00:00.000Z',
+			ended_at: '2026-11-12T07:20:00.000Z',
+		});
+		expect(byId(active.run_id)).toMatchObject({
+			kind: 'run',
+			started_at: '2026-11-12T11:30:00.000Z',
+			ended_at: null,
+		});
+	});
+
+	it('answers an empty page for a hub with no machines', async () => {
+		expect(await expectOk(await superAdmin()('GET', '/admin/machines'))).toEqual({
+			items: [],
+			next_cursor: null,
+		});
+	});
+});
