{
  "name": "keyfleet-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "mix assets.build",
    "typecheck": "tsc --project assets/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "npm run assets:build && playwright test",
    "test:budgets": "vitest run --config vitest.budgets.config.ts",
    "test:chain": "npm run assets:build && playwright test --config playwright.chain.config.ts",
    "test:devices": "npm run assets:build && playwright test --config playwright.devices.config.ts",
    "test:showcase": "playwright test --config playwright.showcase.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@noble/hashes": "1.8.0",
    "@privy-io/react-auth": "3.49.1",
    "@solana-program/system": "0.15.0",
    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.5.0",
    "@vgpu/wgsl": "0.6.0",
    "animejs": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vgpu": "0.6.0",
    "viem": "2.57.7",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.74",
    "lighthouse": "12.6.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "ws@^8.0.0": "8.22.0",
    "axios": "1.20.0",
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1",
    "vgpu@0.6.0": {
      "zod": "4.6.7"
    },
    "@modelcontextprotocol/server": {
      ".": "2.3.1",
      "zod": "4.6.7"
    },
    "@modelcontextprotocol/core": {
      ".": "2.3.1",
      "zod": "4.6.7"
    }
  }
}
