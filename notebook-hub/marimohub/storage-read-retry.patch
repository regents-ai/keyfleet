+		// Some stores (Tigris) cancel reads with 408 RequestCanceled, which the SDK
+		// does not count as transient. Low priority runs inside the SDK's retry step,
+		// so marking the error retryable here lets its retry strategy try again.
+		this.client.middlewareStack.add(
+			(next, context) => async (args) => {
+				try {
+					return await next(args);
+				} catch (error) {
+					if (RETRIED_CANCELLED_READS.has(context.commandName ?? '') && httpStatus(error) === 408) {
+						Object.assign(error as object, { $retryable: {} });
+					}
+					throw error;
+				}
