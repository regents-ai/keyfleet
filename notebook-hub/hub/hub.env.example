# Every setting one fleet's hub (Fly app kf-nb-<fleet>) runs with. Names and
# placeholders only: never commit a value. Lines marked [secret] go in with
# `fly secrets set`; the rest are in fly.hub.toml [env] or baked into the image.

# --- Set by the hub image (hub/Dockerfile); listed so nothing is hidden ---
MARIMOHUB_COMPUTE_BACKEND=library                       # use an external compute library
MARIMOHUB_COMPUTE_LIBRARY=/etc/marimohub/fly-compute.mjs  # the Fly runner library in the image
MARIMOHUB_SANDBOX_EXPOSURE=proxy                        # notebook traffic goes through the hub

# --- Sign-in: KeyFleet's gateway vouches for each person with a signed pass ---
MARIMOHUB_AUTH_BACKEND=proxy-header                     # trust the gateway's signed header
MARIMOHUB_AUTH_PROXY_HEADER=<header name>               # header carrying the pass, e.g. X-KeyFleet-Assertion
MARIMOHUB_AUTH_PROXY_JWT_ISSUER=<issuer URL>            # who signs passes (KeyFleet)
MARIMOHUB_AUTH_PROXY_JWT_AUDIENCE=<audience>            # this fleet's hub, e.g. keyfleet-hub:<fleet_id>
MARIMOHUB_AUTH_PROXY_JWKS_URL=<https URL>               # KeyFleet's public signing keys
MARIMOHUB_AUTH_ALLOWED_EMAIL_DOMAINS=<domain>           # the only email domain passes may carry
MARIMOHUB_AUTH_SESSION_SECRET=<random, 32+ bytes>       # [secret] signs hub cookies and notebook links
MARIMOHUB_APP_BASE_URL=<https URL>                      # the address people use for this hub

# --- Who may do what ---
MARIMOHUB_DEFAULT_ROLE=none                             # people not on the roster get nothing
MARIMOHUB_PROJECT_CREATION=restricted                   # only admins create projects
MARIMOHUB_SUPER_ADMINS=<KeyFleet setup identity>        # the identity KeyFleet sets the hub up with

# --- Notebooks served through the hub ---
MARIMOHUB_SANDBOX_PROXY_ACK_UNTRUSTED=true              # accepts that notebook pages share the hub's web address
MARIMOHUB_PERSIST_WORKSPACE=<source | workspace>        # keep only notebook source, or every workspace file
MARIMOHUB_SESSION_MAX_LIFETIME_SECONDS=<seconds>        # longest a session lives; runner machines are capped at twice this
MARIMOHUB_SESSION_IDLE_TIMEOUT_SECONDS=<seconds>        # end a session nobody has used for this long
MARIMOHUB_RUN_MAINTENANCE=true                          # this hub cleans up its own expired sessions and machines

# --- Storage: one Tigris bucket for this fleet ---
MARIMOHUB_STORAGE_BACKEND=s3                            # Tigris speaks the S3 protocol
MARIMOHUB_STORAGE_S3_ENDPOINT=https://fly.storage.tigris.dev  # Tigris on Fly
MARIMOHUB_STORAGE_S3_REGION=auto                        # Tigris picks the region
MARIMOHUB_STORAGE_S3_BUCKET=<bucket name>               # this fleet's bucket
MARIMOHUB_STORAGE_S3_ACCESS_KEY_ID=<key id>             # [secret] this fleet's bucket key, nobody else's
MARIMOHUB_STORAGE_S3_SECRET_ACCESS_KEY=<secret key>     # [secret]

# --- Runner machines (compute-fly) ---
MARIMOHUB_COMPUTE_IMAGE=registry.fly.io/kf-nbk-<fleet>:<tag>  # runner image(s), comma-separated; first is the default
MARIMOHUB_COMPUTE_FLY_API_URL=http://_api.internal:4280 # Fly Machines API from inside Fly
FLY_API_TOKEN=<token>                                   # [secret] may manage machines in kf-nbk-<fleet> only
MARIMOHUB_COMPUTE_FLY_APP=kf-nbk-<fleet>                # the runner app
MARIMOHUB_COMPUTE_FLY_REGION=<region>                   # where runner machines start
MARIMOHUB_COMPUTE_FLY_CPU_KIND=<shared | performance>   # runner CPU class
MARIMOHUB_COMPUTE_FLY_CPUS=<count>                      # runner CPUs when a notebook asks for no profile
MARIMOHUB_COMPUTE_FLY_MEMORY_MB=<megabytes>             # runner memory when a notebook asks for no profile
MARIMOHUB_COMPUTE_FLY_HELPER_SECRET=<random, 32+ bytes> # [secret] each runner's helper password is derived from this
MARIMOHUB_COMPUTE_FLY_OWNER=kf-nb-<fleet>               # tags this hub's machines; it only ever sees its own
