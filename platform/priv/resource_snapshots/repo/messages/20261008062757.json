  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION keyfleet_app.protect_message();",
      "global?": false,
      "name": "immutable_messages_function",
      "up": "CREATE FUNCTION keyfleet_app.protect_message() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP IN ('DELETE', 'TRUNCATE') THEN\n    RAISE EXCEPTION 'messages cannot be deleted' USING ERRCODE = '23514';\n  END IF;\n  RAISE EXCEPTION 'messages cannot be edited' USING ERRCODE = '23514';\nEND;\n$$;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER immutable_messages ON keyfleet_app.messages;\n",
      "global?": false,
      "name": "immutable_messages_trigger",
      "up": "CREATE TRIGGER immutable_messages BEFORE UPDATE OR DELETE ON keyfleet_app.messages\nFOR EACH ROW EXECUTE FUNCTION keyfleet_app.protect_message();\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER untruncatable_messages ON keyfleet_app.messages;\n",
      "global?": false,
      "name": "untruncatable_messages_trigger",
      "up": "CREATE TRIGGER untruncatable_messages BEFORE TRUNCATE ON keyfleet_app.messages\nFOR EACH STATEMENT EXECUTE FUNCTION keyfleet_app.protect_message();\n"
    }
