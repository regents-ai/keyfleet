+		{
+			name: 'a ghp_ token',
+			line: 'ghp_aBcDeFgHiJkLmNoPqRsTuV0123456789',
+			secret: 'aBcDeFgHiJkLmNoP',
+		},
+		{
+			name: 'a github_pat_ token',
+			line: 'github_pat_11ABCDEFG0123456789_abcdefghijk',
+			secret: '11ABCDEFG0123456789',
+		},
+		{ name: 'a Slack token', line: 'xoxb-1234567890-abcdefghij', secret: '1234567890-abcdefghij' },
+		{ name: 'an AWS key id', line: 'key AKIAIOSFODNN7EXAMPLE used', secret: 'IOSFODNN7EXAMPLE' },
+		{ name: 'a Fly token', line: 'FlyV1 fm2_lJPECAAAAAAAAMk,fm2_abc', secret: 'lJPECAAAAAAAAMk' },
+		{ name: 'a key= pair', line: 'api_key=plainvalue123 next', secret: 'plainvalue123' },
+		{ name: 'a quoted password pair', line: `{'password': 'two words'}`, secret: 'two words' },
+		{ name: 'a token: pair', line: 'access_token: tok_live_x', secret: 'tok_live_x' },
