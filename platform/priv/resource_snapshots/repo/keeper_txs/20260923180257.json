  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION keyfleet_app.protect_keeper_tx();",
      "global?": false,
      "name": "keeper_txs_function",
      "up": "CREATE FUNCTION keyfleet_app.protect_keeper_tx() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP <> 'UPDATE' THEN\n    RAISE EXCEPTION 'keeper transactions cannot be deleted' USING ERRCODE = '23514';\n  END IF;\n  IF ROW(NEW.id, NEW.job, NEW.fleet_id, NEW.function, NEW.target, NEW.from_address,\n         NEW.args, NEW.chain_id, NEW.nonce, NEW.tx_hash, NEW.replaces_tx_hash, NEW.max_fee,\n         NEW.max_priority_fee, NEW.gas_limit, NEW.sent_at)\n     IS DISTINCT FROM\n     ROW(OLD.id, OLD.job, OLD.fleet_id, OLD.function, OLD.target, OLD.from_address,\n         OLD.args, OLD.chain_id, OLD.nonce, OLD.tx_hash, OLD.replaces_tx_hash, OLD.max_fee,\n         OLD.max_priority_fee, OLD.gas_limit, OLD.sent_at) THEN\n    RAISE EXCEPTION 'what a keeper transaction sent cannot be changed' USING ERRCODE = '23514';\n  END IF;\n  IF OLD.status IS NOT NULL THEN\n    RAISE EXCEPTION 'a settled keeper transaction cannot be changed' USING ERRCODE = '23514';\n  END IF;\n  RETURN NEW;\nEND;\n$$;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER protect_keeper_txs ON keyfleet_app.keeper_txs;",
      "global?": false,
      "name": "keeper_txs_trigger",
      "up": "CREATE TRIGGER protect_keeper_txs BEFORE UPDATE OR DELETE ON keyfleet_app.keeper_txs\nFOR EACH ROW EXECUTE FUNCTION keyfleet_app.protect_keeper_tx();\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER untruncatable_keeper_txs ON keyfleet_app.keeper_txs;",
      "global?": false,
      "name": "untruncatable_keeper_txs_trigger",
      "up": "CREATE TRIGGER untruncatable_keeper_txs BEFORE TRUNCATE ON keyfleet_app.keeper_txs\nFOR EACH STATEMENT EXECUTE FUNCTION keyfleet_app.protect_keeper_tx();\n"
    }
