#!/bin/sh

# The site and graph machines run as one Erlang cluster over Fly's private
# IPv6 network (fly.toml). Each node is named keyfleet@<its private address>,
# the same name in every release, so DNSCluster connects the machines of two
# releases while one replaces the other, and RELEASE_COOKIE, a Fly secret,
# lets them in.
: "${RELEASE_COOKIE:?RELEASE_COOKIE must be set: the cluster's machines share it}"
export ERL_AFLAGS="-proto_dist inet6_tcp"
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="<%= @release.name %>@${FLY_PRIVATE_IP:?FLY_PRIVATE_IP must be set: it names this machine in the cluster}"
