# Copy this file to .env, keep machine-specific overrides in .env.local,
# and load both from your ignored .envrc with direnv.
#
# Suggested ignored .envrc contents:
#   source_env .env
#   source_env_if_exists .env.local
#
# After direnv loads the values, prepare the guarded local database with:
#   mix keyfleet.setup_local_auth
#
# Never commit .env, .env.local, or .envrc.

# Privy browser sign-in.
export PRIVY_APP_ID=''

# ES256 verification PUBLIC key, not the Privy app secret: the PEM exactly as
# Privy shows it, with real line breaks. Example shape:
# export PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----'
export PRIVY_VERIFICATION_KEY=''

# The SIWA sign-in server agents use. Unset, development uses a local
# siwa-server on port 4100.
# export KEYFLEET_SIWA_URL=http://localhost:4100

# Deployment-only variable names. Supply values through the deployment's secret store.
# KEYFLEET_APP_SURFACES
# KEYFLEET_DEPLOYMENT_ROLE
# PHX_HOST
# SECRET_KEY_BASE
# PORT
# SENTRY_DSN
# SENTRY_RELEASE
# SENTRY_ENVIRONMENT
# DATABASE_POOLED_URL
# DATABASE_DIRECT_URL
# KEYFLEET_DATABASE_TARGET_MODE
# KEYFLEET_DATABASE_CLUSTER_ID
# KEYFLEET_DATABASE_CLUSTER_NAME
# Agents' pictures: the Tigris bucket's secrets `fly storage create` sets, and
# the public address its objects are read from.
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# AWS_ENDPOINT_URL_S3
# AWS_REGION
# BUCKET_NAME
# PICTURES_PUBLIC_URL
# The private key-art service that draws revealed keys' cards.
# KEY_ART_URL
# Regent's Lighthouse account, which keeps revealed keys' cards on IPFS.
# LIGHTHOUSE_API_KEY
