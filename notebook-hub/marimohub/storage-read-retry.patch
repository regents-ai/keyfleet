+// Reads the SDK may retry after a 408. Writes are left out: a conditional write
+// that landed before the 408 would come back from its retry as a false conflict.
+const RETRIED_CANCELLED_READS = new Set([
+	'GetObjectCommand',
+	'HeadObjectCommand',
+	'ListObjectsV2Command',
+]);
+
