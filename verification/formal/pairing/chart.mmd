stateDiagram-v2
  state "Legend" as legend {
    lg0: Not paired yet
    lg1: Paired
    lg2: Write on its way
    lg3: Saved
    lg4: Refused
    lg5: Breaks NoWriteAfterUnpair
    lg6: Path to the NoWriteAfterUnpair bug
