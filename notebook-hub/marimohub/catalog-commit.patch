+	private async catalogNames(snapshotId: Snapshot['snapshot_id']): Promise<boolean> {
+		const catalogObj = await this.bucket.get(paths.catalog);
+		if (!catalogObj) return false;
+		// A catalog this service could not have written is not the one its put wrote.
+		const catalog = CatalogSchema.safeParse(await catalogObj.json().catch(() => null));
+		return (
+			catalog.success &&
+			(catalog.data.current_snapshot_id === snapshotId ||
+				catalog.data.previous_snapshot_id === snapshotId)
+		);
