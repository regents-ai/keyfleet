+	// A storage client that retries a catalog put whose response was lost gets the
+	// precondition refused by its own landed write. The catalog names the snapshot, so
+	// it is committed and must be kept.
+	function landThenRefuseCatalogPut(bucket: MemoryBucket) {
+		const put = bucket.put.bind(bucket);
+		vi.spyOn(bucket, 'put').mockImplementation(async (key, value, options) => {
+			const result = await put(key, value, options);
+			if (key === paths.catalog) throw new PreconditionFailedError('Retried after landing');
+			return result;
+		});
+	}
+
+	it('keeps a mutation snapshot whose pointer write landed before a refused retry', async () => {
+		const { bucket, services } = await fixture();
+		landThenRefuseCatalogPut(bucket);
+		const committed = await services.catalog.mutateSnapshot('landed', ACTOR, (s) => s);
+		vi.restoreAllMocks();
+		const current = await services.catalog.getCurrentSnapshot();
+		expect(current.snapshot_id).toBe(committed.snapshot_id);
+		expect(current.operation).toBe('landed');
+	});
+
