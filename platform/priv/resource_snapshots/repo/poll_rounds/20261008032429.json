      "down": "DROP FUNCTION keyfleet_app.protect_poll_round();",
      "global?": false,
      "name": "closed_poll_rounds_function",
      "up": "CREATE FUNCTION keyfleet_app.protect_poll_round() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP = 'DELETE' THEN\n    RAISE EXCEPTION 'poll rounds cannot be deleted' USING ERRCODE = '23514';\n  END IF;\n  IF OLD.status = 'closed' THEN\n    RAISE EXCEPTION 'a closed poll round cannot change' USING ERRCODE = '23514';\n  END IF;\n  RETURN NEW;\nEND;\n$$;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER protect_poll_rounds ON keyfleet_app.poll_rounds;",
      "global?": false,
      "name": "closed_poll_rounds_trigger",
      "up": "CREATE TRIGGER protect_poll_rounds BEFORE UPDATE OR DELETE ON keyfleet_app.poll_rounds\nFOR EACH ROW EXECUTE FUNCTION keyfleet_app.protect_poll_round();\n"
    }
