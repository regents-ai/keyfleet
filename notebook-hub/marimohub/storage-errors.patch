+/**
+ * What an object store said about a failed call (AWS SDK `$metadata`): its HTTP
+ * status, its request ids and how many tries were made. Ids and numbers only, so
+ * safe to log; a store support ticket needs the ids.
+ */
+export function storageMetadata(err: unknown): Record<string, string | number> | undefined {
+	const meta = (err as { $metadata?: Record<string, unknown> } | null)?.$metadata;
+	if (!meta || typeof meta !== 'object') return undefined;
+	const out: Record<string, string | number> = {};
+	for (const [key, field] of [
+		['http_status', meta.httpStatusCode],
+		['request_id', meta.requestId],
+		['extended_request_id', meta.extendedRequestId],
+		['attempts', meta.attempts],
+	] as const) {
+		if (typeof field === 'number' && Number.isFinite(field)) out[key] = field;
+		if (typeof field === 'string' && field.length <= 256) out[key] = field;
+	}
+	return Object.keys(out).length > 0 ? out : undefined;
+}
