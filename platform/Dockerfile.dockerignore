*
!platform/assets/**
!platform/config/**
!platform/contracts/**
!platform/lib/**
!platform/priv/**
!platform/rel/**
!platform/mix.exs
!platform/mix.lock
!platform/package.json
!platform/package-lock.json
!cli/commands.json
# The graph host enters as its project files, lockfile, source and upstream
# licence files. Its tests and any local environment stay out.
!platform/graph_host/pyproject.toml
!platform/graph_host/uv.lock
!platform/graph_host/.python-version
!platform/graph_host/src/**
!platform/graph_host/third_party/**
!uv-cache/**
!python-cache/**

# Bytecode is output, not source.
**/__pycache__

# The copied source trees must never carry runtime environment files.
**/.env
**/.env.*
**/.envrc
