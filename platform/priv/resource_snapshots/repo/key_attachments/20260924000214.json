  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION keyfleet_app.protect_key_epoch();",
      "global?": false,
      "name": "immutable_epochs_function",
      "up": "CREATE FUNCTION keyfleet_app.protect_key_epoch() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP = 'DELETE' THEN\n    RAISE EXCEPTION 'key ownership epochs cannot be deleted' USING ERRCODE = '23514';\n  END IF;\n  IF ROW(NEW.id, NEW.fleet_id, NEW.token_id, NEW.ownership_epoch, NEW.owner_wallet,\n         NEW.block_number, NEW.block_hash, NEW.transaction_hash, NEW.log_index, NEW.observed_at,\n         NEW.record_seq)\n     IS DISTINCT FROM\n     ROW(OLD.id, OLD.fleet_id, OLD.token_id, OLD.ownership_epoch, OLD.owner_wallet,\n         OLD.block_number, OLD.block_hash, OLD.transaction_hash, OLD.log_index, OLD.observed_at,\n         OLD.record_seq) THEN\n    RAISE EXCEPTION 'key ownership projection fields are immutable' USING ERRCODE = '23514';\n  END IF;\n  RETURN NEW;\nEND;\n$$;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER immutable_key_epochs ON keyfleet_app.key_attachments;\n",
      "global?": false,
      "name": "immutable_epochs_trigger",
      "up": "CREATE TRIGGER immutable_key_epochs BEFORE UPDATE OR DELETE ON keyfleet_app.key_attachments\nFOR EACH ROW EXECUTE FUNCTION keyfleet_app.protect_key_epoch();\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION keyfleet_app.refuse_key_epoch_truncate();",
      "global?": false,
      "name": "untruncatable_epochs_function",
      "up": "CREATE FUNCTION keyfleet_app.refuse_key_epoch_truncate() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  RAISE EXCEPTION 'key ownership epochs cannot be deleted' USING ERRCODE = '23514';\nEND;\n$$;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER untruncatable_key_epochs ON keyfleet_app.key_attachments;\n",
      "global?": false,
      "name": "untruncatable_epochs_trigger",
      "up": "CREATE TRIGGER untruncatable_key_epochs BEFORE TRUNCATE ON keyfleet_app.key_attachments\nFOR EACH STATEMENT EXECUTE FUNCTION keyfleet_app.refuse_key_epoch_truncate();\n"
    }
  ],
