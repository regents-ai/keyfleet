+		it('keeps only notebooks updated after updated_after', async () => {
+			const kept = await expectOk<any>(await create('Kept', 'Edited later', []), 201);
+			await create('Untouched', 'Never edited', []);
+			await new Promise((resolve) => setTimeout(resolve, 5));
+			const after = new Date().toISOString();
+			await new Promise((resolve) => setTimeout(resolve, 5));
+			await expectOk(await request('PATCH', nb(`/${kept.id}`), { title: 'Kept, edited' }));
+			const made = await expectOk<any>(await create('Made', 'Made later', []), 201);
 
+			const page = await expectOk<any>(
+				await request('GET', nb(`?updated_after=${encodeURIComponent(after)}&limit=1`)),
+			);
+			const next = await expectOk<any>(
+				await request(
+					'GET',
+					nb(
+						`?updated_after=${encodeURIComponent(after)}&limit=1&cursor=${encodeURIComponent(page.next_cursor)}`,
+					),
+				),
+			);
+			expect([...page.items, ...next.items].map((n: any) => n.id)).toEqual([made.id, kept.id]);
+			expect(next.next_cursor).toBeNull();
+			await expectError(
+				await request('GET', nb('?updated_after=yesterday')),
+				422,
+				'VALIDATION_ERROR',
+			);
+		});
