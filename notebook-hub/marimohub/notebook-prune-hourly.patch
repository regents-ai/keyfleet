 /**
+ * Per-notebook upload and thumbnail cleanup, hourly: nothing it removes expires in
+ * under a day, and visiting every notebook is most of a cycle's bucket reads. Its
+ * own lease, so a long prune never holds off the five-minute maintenance cycle.
+ */
+export function startNotebookPrune(deps: ApiDeps, loops = new BackgroundLoops()): () => void {
+	return loops.start({
+		name: 'notebook_prune',
+		intervalMs: Millis.hours(1),
+		lock: maintenanceLock(deps, paths.notebookPruneLock),
+		notLeaderEvent: 'notebook_prune_skipped_not_leader',
+		run: async ({ holder, step }) => ({
+			holder,
+			notebooks: await step(() => deps.services.notebooks.pruneNotebooks()),
+		}),
+		onSuccess: (counts) => {
+			logEvent({ level: 'info', event: 'notebook_prune_cycle', ...counts });
+		},
+	}).stop;
+}
+
+/**
  * Keep session teardown and snapshot cadence independent of the heavier prune
  * cycle. A separate lease lets both loops run on the maintenance replica.
  */
