+app.openapi(listMachines, async (c) => {
+	const deps = c.get('deps');
+	assertSessionAuthenticated(c, 'access admin endpoints');
+	await assertSuperAdmin(c.get('user'), deps);
+	c.header('Cache-Control', 'no-store');
+	const { catalog, jobRuns, sessions } = deps.services;
+	const [held, snapshot] = await Promise.all([
+		sessions.listSessions(),
+		catalog.getCurrentSnapshot(),
+	]);
+	const runs = await mapWithConcurrency(
+		indexedJobs(snapshot),
+		BUCKET_SCAN_CONCURRENCY,
+		({ projectId, notebookId, entry }) => jobRuns.listRuns(projectId, notebookId, entry.id),
+	);
+	const items = [
+		...held.flatMap((session) =>
+			session.sandbox_id
+				? [
+						{
+							id: session.session_id,
+							kind: 'session' as const,
+							started_at: session.started_at,
+							ended_at: isTerminal(session.status) ? (session.sandbox_reclaimed_at ?? null) : null,
+						},
+					]
+				: [],
+		),
+		...runs.flat().flatMap((run) =>
+			run.started_at
+				? [
+						{
+							id: run.run_id,
+							kind: 'run' as const,
+							started_at: run.started_at,
+							ended_at: run.finished_at ?? null,
+						},
+					]
+				: [],
+		),
+	];
+	return c.json({ success: true, data: { items, next_cursor: null } }, 200);
+});
+
