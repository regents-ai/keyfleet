+			secret: base64Of(`${'u'.repeat(offset - 1)}:${INJECTED}`).slice(4, -4),
+			injected: [INJECTED],
+		})),
+		{
+			name: 'an Authorization header',
+			line: 'Authorization: Basic dXNlcjpwYXNz',
+			secret: 'dXNlcjpwYXNz',
