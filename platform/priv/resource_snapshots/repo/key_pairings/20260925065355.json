  "custom_statements": [
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION keyfleet_app.protect_key_pairing();",
      "global?": false,
      "name": "immutable_pairings_function",
      "up": "CREATE FUNCTION keyfleet_app.protect_key_pairing() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  IF TG_OP = 'DELETE' THEN\n    RAISE EXCEPTION 'key pairings cannot be deleted' USING ERRCODE = '23514';\n  END IF;\n  IF ROW(NEW.id, NEW.fleet_id, NEW.token_id, NEW.ownership_epoch, NEW.owner_wallet,\n         NEW.operator_wallet, NEW.agent_profile_id, NEW.requested_at)\n     IS DISTINCT FROM\n     ROW(OLD.id, OLD.fleet_id, OLD.token_id, OLD.ownership_epoch, OLD.owner_wallet,\n         OLD.operator_wallet, OLD.agent_profile_id, OLD.requested_at) THEN\n    RAISE EXCEPTION 'key pairing identity is immutable' USING ERRCODE = '23514';\n  END IF;\n  RETURN NEW;\nEND;\n$$;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER immutable_key_pairings ON keyfleet_app.key_pairings;\n",
      "global?": false,
      "name": "immutable_pairings_trigger",
      "up": "CREATE TRIGGER immutable_key_pairings BEFORE UPDATE OR DELETE ON keyfleet_app.key_pairings\nFOR EACH ROW EXECUTE FUNCTION keyfleet_app.protect_key_pairing();\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP FUNCTION keyfleet_app.refuse_key_pairing_truncate();",
      "global?": false,
      "name": "untruncatable_pairings_function",
      "up": "CREATE FUNCTION keyfleet_app.refuse_key_pairing_truncate() RETURNS trigger LANGUAGE plpgsql AS $$\nBEGIN\n  RAISE EXCEPTION 'key pairings cannot be deleted' USING ERRCODE = '23514';\nEND;\n$$;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP TRIGGER untruncatable_key_pairings ON keyfleet_app.key_pairings;\n",
      "global?": false,
      "name": "untruncatable_pairings_trigger",
      "up": "CREATE TRIGGER untruncatable_key_pairings BEFORE TRUNCATE ON keyfleet_app.key_pairings\nFOR EACH STATEMENT EXECUTE FUNCTION keyfleet_app.refuse_key_pairing_truncate();\n"
    }
  ],
