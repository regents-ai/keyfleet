+	/**
+	 * Drop each notebook's expired workspace uploads and its thumbnail images and
+	 * attempts over a day old, in every project not awaiting `sweepDeletedProjects`.
+	 * Nothing here expires in under a day, so an hourly pass keeps up at a twelfth of
+	 * the bucket reads of running it with every five-minute maintenance cycle.
+	 * Returns the number of notebooks visited.
+	 */
+	async pruneNotebooks(): Promise<number> {
+		const snapshot = await this.catalog.getCurrentSnapshot();
+		const notebooks = snapshot.projects
+			.filter((p) => p.status !== 'deleted')
+			.flatMap((project) => project.notebooks.map((nb) => ({ project, nb })));
+		// Each notebook is a few bucket round trips, so they run side by side.
+		await mapWithConcurrency(notebooks, BUCKET_SCAN_CONCURRENCY, async ({ project, nb }) => {
+			await this.workspace.sweepUploads(project.id, nb.id).catch((error) => {
+				logOperationalError(
+					'workspace_uploads.cleanup_failed',
+					{ operation: 'prune', project_id: project.id, notebook_id: nb.id },
+					error,
+				);
+			});
+			await this.thumbnails.prune(project.id, nb.id).catch((error) => {
+				logOperationalError(
+					'thumbnails.cleanup_failed',
+					{ operation: 'prune', project_id: project.id, notebook_id: nb.id },
+					error,
+				);
+			});
+		});
+		return notebooks.length;
 	}
