#!/bin/sh

# The machines share no Erlang cluster: the site reaches the graph machine over
# HTTP (Keyfleet.Graph.Client). Distribution stays on only so an operator on a
# machine can run `bin/keyfleet rpc` and `remote` there. The node is named
# keyfleet@127.0.0.1, its distribution port listens on the loopback address
# only, and so does its port mapper (epmd), so no other machine can reach
# either. The cookie is the release's own (releases/COOKIE) unless
# RELEASE_COOKIE is set; nothing off the machine can use it.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="<%= @release.name %>@127.0.0.1"
export ERL_EPMD_ADDRESS=127.0.0.1
export ERL_AFLAGS="-kernel inet_dist_use_interface {127,0,0,1}"
