+	// Runs the real layer with this machine's python3 (needs tomllib and
+	// packaging, as the sandbox image's Python has) and a uv that only records.
+	describe('the pyproject layer keeps the image Python', () => {
+		const [{ command }] = buildMarimoLaunch(BASE).setup;
+
+		function runLayer(requiresPython: string | undefined, dependencies: string[]) {
+			const dir = mkdtempSync(join(tmpdir(), 'pyproject-layer-'));
+			try {
+				mkdirSync(join(dir, 'bin'));
+				writeFileSync(
+					join(dir, 'bin', 'uv'),
+					`#!/bin/sh\necho "$@" >> '${join(dir, 'uv.calls')}'\n`,
+					{
+						mode: 0o755,
+					},
+				);
+				writeFileSync(
+					join(dir, 'pyproject.toml'),
+					[
+						'[project]',
+						'name = "notebook"',
+						'version = "0.1.0"',
+						...(requiresPython ? [`requires-python = "${requiresPython}"`] : []),
+						`dependencies = ${JSON.stringify(dependencies)}`,
+					].join('\n'),
+				);
+				const result = spawnSync('sh', ['-c', command], {
+					cwd: dir,
+					env: { ...process.env, PATH: `${join(dir, 'bin')}:${process.env.PATH}` },
+				});
+				const calls = existsSync(join(dir, 'uv.calls'))
+					? readFileSync(join(dir, 'uv.calls'), 'utf8').trim().split('\n')
+					: [];
+				return { status: result.status, uv: calls };
+			} finally {
+				rmSync(dir, { recursive: true, force: true });
+			}
+		}
+
+		it('stops before uv when requires-python excludes the running Python', () => {
+			expect(runLayer('<3', ['humanize'])).toEqual({ status: 3, uv: [] });
+		});
+
+		it('syncs pinned to the running Python when requires-python allows it or is absent', () => {
+			const sync = [
+				'sync --inexact --no-install-package marimo --no-compile-bytecode --python python3',
+			];
+			expect(runLayer('>=3', ['humanize'])).toEqual({ status: 0, uv: sync });
+			expect(runLayer(undefined, ['humanize'])).toEqual({ status: 0, uv: sync });
+		});
+
+		it('leaves a project without dependencies on the image environment', () => {
+			expect(runLayer('<3', [])).toEqual({ status: 0, uv: [] });
+		});
+
+		it('stops on a requires-python it cannot read', () => {
+			const { status, uv } = runLayer('not a version', ['humanize']);
+			expect(status).not.toBe(0);
+			expect(uv).toEqual([]);
+		});
+	});
+
 	it('reserves exit code 2 for no dependencies and propagates TOML parse failures', () => {
 		const [{ command: pyproject }] = buildMarimoLaunch(BASE).setup;
-		expect(pyproject).toContain('import pathlib,sys,tomllib');
+		expect(pyproject).toContain('import pathlib,platform,sys,tomllib');
 		expect(pyproject).not.toContain("find_spec('tomllib')");
 		expect(pyproject).toContain('else 2');
 		expect(pyproject).toContain('elif [ "$status" -eq 2 ]');
